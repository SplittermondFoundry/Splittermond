<!--DO NOT CHANGE THIS TEMPLATE UNLESS YOU ALSO CHANGE THE SpellRollTemplateInterfaces.ts FILE-->
<div class="splittermond spell check {{rollResultClass}}">
    {{#with header}}
        {{> chat-card-header alt="Icon attached to the spell"}}
    {{/with}}
    {{> roll-result rollResult}}
    {{#with spellValues}}
        <div class="chat-card-segment spell-values">
            <strong>{{#if enhanced}}{{localize "splittermond.spellValues.enhanced"}}{{else}}{{localize "splittermond.spellValues.normal"}}{{/if}}</strong>
            <dl>
                <dt>{{localize "splittermond.damageType"}}</dt><dd>{{localize damageType}}</dd>
                <dt>{{localize "splittermond.damageCategory"}}</dt><dd>{{localize costType}}</dd>
                {{#if features}}<dt>{{localize "splittermond.features"}}</dt><dd>{{features}}</dd>{{/if}}
                {{#if range}}<dt>{{localize "splittermond.range"}}</dt><dd>{{range}}</dd>{{/if}}
                {{#if effectArea}}<dt>{{localize "splittermond.effectArea"}}</dt><dd>{{effectArea}}</dd>{{/if}}
                {{#if effectDuration}}<dt>{{localize "splittermond.effectDuration"}}</dt><dd>{{effectDuration}}</dd>{{/if}}
            </dl>
        </div>
    {{/with}}
    {{> degree-of-success-display degreeOfSuccessDisplay}}
    <div class="splittermond-chat-action-container chat-card-segment">
        {{> degree-of-success-options degreeOfSuccessOptions}}
    </div>
    <div class="actions splittermond-chat-action-container chat-card-segment">
        <h3>{{localize "splittermond.furtherActions"}}</h3>
        {{#with actions}}
            {{#if activeDefense }}
                {{> "activeDefenseButton" activeDefense}}
            {{/if}}
            {{#if applyDamage}}
                {{> "applyDamageButton" applyDamage}}
            {{/if}}
            {{#if consumeCosts}}
                {{> "consumeCostsButton" consumeCosts}}
            {{/if}}
            {{#if advanceToken}}
                {{> "advanceTokenButton" advanceToken}}
            {{/if}}
            {{#if useSplinterpoint}}
                {{> "useSplinterpointButton" useSplinterpoint}}
            {{/if}}
            {{#if rollMagicFumble}}
                {{> "rollFumbleButton" rollMagicFumble}}
            {{/if}}
        {{/with}}

        {{#* inline "applyDamageButton"}}
            <button class="splittermond-chat-action" data-action="applyDamage" {{#if disabled}}disabled{{/if}}>
                <i class="fas fa-heart-broken"></i>
                {{value}} {{localize "splittermond.damage"}}
            </button>
        {{/inline}}
        {{#* inline "consumeCostsButton"}}
            <button class="splittermond-chat-action" data-action="consumeCosts" {{#if disabled}}disabled{{/if}}>
                <i class="fas fa-bullseye"></i>
                {{value}} {{localize "splittermond.focusCostsAbbrev"}}
            </button>
        {{/inline}}
        {{#* inline "advanceTokenButton"}}
            <button class="splittermond-chat-action" data-action="advanceToken" {{#if disabled}}disabled{{/if}}>
                <i class="fas fa-stopwatch"></i>
                {{value}} {{localize "splittermond.ticks"}}
            </button>
        {{/inline}}
        {{#* inline "useSplinterpointButton"}}
            <button class="splittermond-chat-action" data-action="useSplinterpoint" {{#if disabled}}disabled{{/if}}>
                <i class="fas fa-moon"></i>
                {{localize "splittermond.splinterpoint"}}
            </button>
        {{/inline}}
        {{#* inline "rollFumbleButton"}}
            <button class="splittermond-chat-action" data-localAction="rollMagicFumble" {{#if disabled}}disabled{{/if}}>
                <i class="fas fa-dice"></i>
                {{localize "splittermond.fumbleTableLabel"}}
            </button>
        {{/inline}}
        {{#* inline "activeDefenseButton"}}
            <button class="splittermond-chat-action" data-localAction="activeDefense">
                <i class="fas fa-shield-alt"></i>
                {{localize "splittermond.activeDefense"}} ({{difficulty}})
            </button>
        {{/inline}}
    </div>
</div>
