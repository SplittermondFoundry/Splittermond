<section class="tab {{tabs.properties.id}} {{tabs.properties.cssClass}}" data-group="primary" data-tab="properties">
    <div>
        {{#*inline "readonlyLocalize"}}
            <span>{{localize templateData.value}}</span>
        {{/inline}}
        {{#*inline "readonly"}}
            <span>{{templateData.value}}</span>
        {{/inline}}
        {{#*inline "input"}}
            <input name="{{templateData.field}}" type="text" value="{{templateData.value}}"
                   aria-label="{{localize templateData.label}}{{#if columnLabel}} – {{localize columnLabel}}{{/if}}"
                   placeholder="{{localize templateData.placeholderText}}"/>
        {{/inline}}
        {{#*inline "textarea"}}
            <textarea name="{{templateData.field}}" rows="2" aria-label="{{localize templateData.label}}{{#if columnLabel}} – {{localize columnLabel}}{{/if}}">{{templateData.value}}</textarea>
        {{/inline}}
        {{#*inline "bool"}}
            <input name="{{templateData.field}}" type="checkbox" value="true" {{#if
                    templateData.value}}checked{{/if}} aria-label="{{localize templateData.label}}{{#if columnLabel}} – {{localize columnLabel}}{{/if}}" />
        {{/inline}}
        {{#*inline "select"}}
            <select name="{{templateData.field}}" aria-label="{{localize templateData.label}}{{#if columnLabel}} – {{localize columnLabel}}{{/if}}">
                {{selectOptions templateData.choices selected=templateData.value localize=true}}
            </select>
        {{/inline}}
        {{#*inline "inputNumberWithSpinner"}}
            <div class="row">
                <button class="button-inline" type="button" data-action="dec-value"
                        data-input-query="input[name='{{templateData.field}}']">
                    <i class="fa fa-minus" aria-hidden="true"></i></button>
                <input name="{{templateData.field}}" type="number" value="{{templateData.value}}"
                       placeholder="{{localize templateData.placeholderText}}" dtype="Number"
                       aria-label="{{localize templateData.label}}{{#if columnLabel}} – {{localize columnLabel}}{{/if}}"/>
                <button class="button-inline" type="button" data-action="inc-value"
                        data-input-query="input[name='{{templateData.field}}']">
                    <i class="fa fa-plus" aria-hidden="true"></i></button>
            </div>
        {{/inline}}
        {{#each itemProperties}}
            <div class="properties-editor {{#if columnLabels}}properties-comparison{{/if}} {{#if layout}}properties-{{layout}}{{/if}}">
                {{#if groupName}}<h3>{{localize groupName}}</h3>{{/if}}
                {{#if columnLabels}}
                    {{#if columnLabels.help}}<p class="comparison-help">{{localize columnLabels.help}}</p>{{/if}}
                    <span></span>
                    <strong>{{localize columnLabels.normal}}</strong>
                    <strong>{{localize columnLabels.comparison}}</strong>
                {{/if}}
                {{#each this.properties}}
                    <label>{{localize label}}</label>
                    <div class="property-input">{{> (lookup . 'template') templateData=this columnLabel=../columnLabels.normal}}</div>
                    {{#if ../columnLabels}}
                        <div class="property-input {{#if comparison.inherited}}property-inherited{{/if}}">
                            {{#with comparison}}{{> (lookup . 'template') templateData=this columnLabel=../../columnLabels.comparison}}{{/with}}
                        </div>
                    {{/if}}
                    {{#if this.help}}
                        <label></label>
                        <div class="help-text">{{{this.help}}}</div>
                    {{/if}}
                {{/each}}
            </div>
        {{/each}}
    </div>
</section>
