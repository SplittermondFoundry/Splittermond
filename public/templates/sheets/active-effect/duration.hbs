<section class="tab duration{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <div class="splittermond-active-effect-duration">
        <div class="form-group">
            <label>{{localize "splittermond.activeEffect.duration.mode"}}</label>
            <select name="flags.splittermond.durationMode" {{#unless editable}}disabled{{/unless}}>
                {{selectOptions durationModeChoices selected=durationMode localize=true}}
            </select>
        </div>

        {{#if (eq durationMode "timed")}}
            <div class="form-group duration-value">
                <label>{{localize "splittermond.activeEffect.duration.value"}}</label>
                <input type="number" name="duration.value" value="{{durationValue}}" step="1" min="1" {{#unless editable}}disabled{{/unless}} />
            </div>
            <div class="form-group duration-unit">
                <label>{{localize "splittermond.activeEffect.duration.unit"}}</label>
                <select name="duration.units" {{#unless editable}}disabled{{/unless}}>
                    {{selectOptions durationUnitChoices selected=durationUnits localize=true}}
                </select>
            </div>
            <input type="hidden" name="duration.expiry" value="{{durationExpiry}}" />

            <div class="form-group status">
                <label>{{localize "splittermond.activeEffect.duration.status"}}</label>
                <span{{#if isExpired}} class="expired"{{else}} class="active"{{/if}}>{{#if isExpired}}{{localize "splittermond.activeEffect.duration.statusExpired"}}{{else}}{{localize "splittermond.activeEffect.duration.statusActive"}}{{/if}}</span>
            </div>

            <div class="form-group time-type">
                <label>{{localize "splittermond.activeEffect.duration.timeType"}}</label>
                <span>{{localize durationTimeTypeKey}}</span>
            </div>
            {{#if durationStart}}
                <div class="form-group start">
                    <label>{{localize "splittermond.activeEffect.duration.start"}}</label>
                    <span>{{durationStart}}</span>
                </div>
            {{/if}}
            {{#if durationRemaining}}
                <div class="form-group remaining">
                    <label>{{localize "splittermond.activeEffect.duration.remaining"}}</label>
                    <span>{{durationRemaining}}</span>
                </div>
            {{/if}}
        {{/if}}
    </div>
</section>
